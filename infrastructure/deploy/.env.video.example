# Copy this file outside the Git working tree. Do not use any example value as a secret.
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=<set-a-unique-postgres-password-at-deploy>

MINIO_ROOT_USER=video
MINIO_ROOT_PASSWORD=<set-a-unique-minio-password-at-deploy>
S3_REGION=us-east-1
S3_BUCKET=video-assets
S3_PUBLIC_ENDPOINT=https://assets.video.aiself.vip
S3_BROWSER_ORIGINS=https://video.aiself.vip

# The API and Worker must share this high-entropy key. It is not a Provider key.
REFERENCE_DELIVERY_SIGNING_KEY=<set-a-high-entropy-signing-key-at-deploy>
REFERENCE_DELIVERY_ORIGIN=https://video.aiself.vip

# Keep mock until the target VPS, TLS, private edge login, and Worker-only Provider secrets are verified.
VIDEO_PROVIDER=mock
SUB2API_VIDEO_BASE_URL=
SUB2API_VIDEO_API_KEY=

# This is an absolute path on the Video VPS, never a repository path.
VIDEO_EDGE_HTPASSWD_FILE=/opt/alchemy-video/secrets/video-users.htpasswd
EDGE_NGINX_CONFIG=./nginx/video.bootstrap.conf
TZ=Asia/Shanghai
