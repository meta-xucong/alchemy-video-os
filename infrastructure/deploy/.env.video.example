# Copy this file outside the Git working tree. Do not use any example value as a secret.
POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=<set-a-unique-postgres-password-at-deploy>

MINIO_ROOT_USER=video
MINIO_ROOT_PASSWORD=<set-a-unique-minio-password-at-deploy>
S3_REGION=us-east-1
S3_BUCKET=video-assets
S3_PUBLIC_ENDPOINT=https://assets.video.aiself.vip
S3_BROWSER_ORIGINS=https://video.aiself.vip

# The API and Worker must share this high-entropy key. It is not a Provider key.
REFERENCE_DELIVERY_SIGNING_KEY=<set-a-high-entropy-signing-key-at-deploy>
REFERENCE_VISION_BASE_URL=
REFERENCE_VISION_API_KEY=
REFERENCE_VISION_MODEL=
REFERENCE_DELIVERY_ORIGIN=https://video.aiself.vip
# Worker-side relay readiness guard. Keep enabled in production; only disable for diagnostics.
REFERENCE_DELIVERY_PREFLIGHT_ENABLED=true
REFERENCE_DELIVERY_PREFLIGHT_TIMEOUT_MS=5000
REFERENCE_DELIVERY_PREFLIGHT_RETRIES=2
REFERENCE_DELIVERY_TTL_MS=900000

AUDIO_FREE_ONLY=true

DOCUMENT_RUNTIME_TOKEN=<set-a-private-document-runtime-token-at-deploy>
MEDIA_RUNTIME_TOKEN=<set-a-private-media-runtime-token-at-deploy>
VIDEO_PROMPT_MAX_UTF8_BYTES=20000

# Keep mock until the target VPS, TLS, private edge login, and Worker-only Provider secrets are verified.
VIDEO_PROVIDER=mock
SUB2API_VIDEO_BASE_URL=
SUB2API_VIDEO_API_KEY=

# Enable only after the Sub2API Veyra internal token is provisioned on the VPS.
VEYRA_AUTH_ENABLED=false
VIDEO_VEYRA_INTERNAL_BASE_URL=https://aiself.vip
VIDEO_VEYRA_INTERNAL_TOKEN=
VIDEO_SESSION_SECRET=<set-a-high-entropy-video-session-secret-at-deploy>
VIDEO_BILLING_CHARGE_AMOUNT=1

# This is an absolute path on the Video VPS, never a repository path.
VIDEO_EDGE_HTPASSWD_FILE=/opt/alchemy-video/secrets/video-users.htpasswd
EDGE_NGINX_CONFIG=./nginx/video.bootstrap.conf
TZ=Asia/Shanghai
