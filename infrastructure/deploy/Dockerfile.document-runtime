FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY services/document-runtime/pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir "fastapi>=0.115,<1.0" "uvicorn>=0.30,<1.0" "markitdown>=0.1.7,<0.2"
COPY services/document-runtime/main.py services/document-runtime/runtime.py ./

