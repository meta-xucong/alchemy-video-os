{
  "name": "alchemy-video-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @alchemy-video/studio-web --filter @alchemy-video/control-api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "contracts:generate": "pnpm --filter @alchemy-video/contracts generate",
    "db:generate": "pnpm --filter @alchemy-video/persistence db:generate",
    "db:migrate": "pnpm --filter @alchemy-video/persistence db:migrate",
    "infra:up": "docker compose -f infrastructure/compose/docker-compose.local.yml up -d",
    "infra:down": "docker compose -f infrastructure/compose/docker-compose.local.yml down"
  }
}
