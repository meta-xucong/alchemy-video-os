# Local development only. Copy to .env.local; do not commit the copy.
NODE_ENV=development
CONTROL_API_PORT=3032
CONTROL_API_ORIGIN=http://127.0.0.1:3032
DATABASE_URL=postgresql://video_local:video_local@127.0.0.1:15432/video_local
REDIS_URL=redis://127.0.0.1:6380
S3_ENDPOINT=http://127.0.0.1:9002
S3_REGION=us-east-1
S3_BUCKET=video-local
S3_ACCESS_KEY=video_local
S3_SECRET_KEY=video_local_secret
POSTGRES_DB=video_local
POSTGRES_USER=video_local
POSTGRES_PASSWORD=video_local
MINIO_ROOT_USER=video_local
MINIO_ROOT_PASSWORD=video_local_secret
LOCAL_AUTH_MODE=dev
VIDEO_PROVIDER=mock
VEYRA_AUTH_ENABLED=false
SUB2API_VIDEO_BASE_URL=
SUB2API_VIDEO_API_KEY=
VEYRA_INTERNAL_TOKEN=
VEYRA_SESSION_SECRET=
MOCK_VIDEO_OUTCOME=success
CERTIFY_LIVE_VIDEO=false
CERTIFY_MAX_SUBMISSIONS=0
