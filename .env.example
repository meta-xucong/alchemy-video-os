# Local development only. Copy to .env.local; do not commit the copy.
NODE_ENV=development
CONTROL_API_PORT=3032
CONTROL_API_ORIGIN=http://127.0.0.1:3032
DATABASE_URL=postgresql://video_local:video_local@127.0.0.1:15432/video_local
REDIS_URL=redis://127.0.0.1:6380
S3_ENDPOINT=http://127.0.0.1:9002
# Optional production-only browser endpoint for presigned upload/download URLs.
# Server-side reads and writes stay on S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_BROWSER_ORIGINS=
S3_REGION=us-east-1
S3_BUCKET=video-local
S3_ACCESS_KEY=video_local
S3_SECRET_KEY=video_local_secret
POSTGRES_DB=video_local
POSTGRES_USER=video_local
POSTGRES_PASSWORD=video_local
MINIO_ROOT_USER=video_local
MINIO_ROOT_PASSWORD=video_local_secret
MINIO_API_CORS_ALLOW_ORIGIN=http://127.0.0.1:3031,http://localhost:3031
LOCAL_AUTH_MODE=dev
VIDEO_PROVIDER=mock
VEYRA_AUTH_ENABLED=false
# Hard gate: only local/workspace-authorized audio paths are allowed. Paid
# music/TTS providers are never loaded while this is true.
AUDIO_FREE_ONLY=true
# Pixabay keeps the explicit source-aligned import route; AUTO may perform one
# server-side search only when no usable workspace MUSIC asset exists.
PIXABAY_MUSIC_ENABLED=true
DOCUMENT_RUNTIME_URL=http://127.0.0.1:3040
DOCUMENT_RUNTIME_TOKEN=document_runtime_local_token
DOCUMENT_CONVERSION_QUEUE_NAME=
DOCUMENT_CONVERSION_DEAD_LETTER_QUEUE_NAME=
# The local full stack exposes Media Runtime on this loopback port. Pixabay
# imports remain disabled when this protected runtime is not configured.
MEDIA_RUNTIME_URL=http://127.0.0.1:3433/
MEDIA_RUNTIME_TOKEN=local-media-runtime-token
SUB2API_VIDEO_BASE_URL=
SUB2API_VIDEO_API_KEY=
REFERENCE_DELIVERY_ORIGIN=
# Optional server-side multimodal reference analysis. Without all three values,
# image roles remain unresolved until the user describes them in the idea text.
REFERENCE_VISION_BASE_URL=
REFERENCE_VISION_API_KEY=
REFERENCE_VISION_MODEL=
# Optional local Piper voice model directory. The bundled local setup uses
# .codex-longrun/piper-models/zh_CN-huayan-medium.onnx.
PIPER_MODEL_PATH=
PIPER_MODEL_CONFIG_PATH=
VEYRA_INTERNAL_TOKEN=
VEYRA_SESSION_SECRET=
MOCK_VIDEO_OUTCOME=success
CERTIFY_LIVE_VIDEO=false
CERTIFY_MAX_SUBMISSIONS=0
